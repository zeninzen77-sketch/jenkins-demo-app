pipeline {
    agent any

    environment {
        APP_NAME = "ZeninApp"
    }

    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/zeninzen77-sketch/jenkins-demo-app.git'
            }
        }

        stage('Build') {
            steps {
                echo "Building ${APP_NAME}"
                sh 'ls -la'
            }
        }

        stage('Test') {
            steps {
                echo "Testing ${APP_NAME}"
            }
        }
    }
}
