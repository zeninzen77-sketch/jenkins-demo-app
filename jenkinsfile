pipeline {
    agent any

    environment {
        APP_NAME = "zenin-demo-app"
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/zeninzen77-sketch/jenkins-demo-app.git'
            }
        }

        stage('Build') {
            steps {
                echo "Building ${APP_NAME}"
                sh 'ls -la'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t zenin-demo-app .'
            }
        }

    }
}
